# Copy to .env and fill in real values. Never commit .env.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

DATABASE_URL=
DATA_DIR=data

# Offline demo mode (optional, false by default; true = deterministic fake AI)
OFFLINE_MODE=false

MAX_FILE_SIZE_BYTES=5242880
LOG_LEVEL=INFO
MAX_RETRIES=3
CONCURRENCY_LIMIT=8
AI_TIMEOUT_SECONDS=30
